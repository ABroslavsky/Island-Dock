{
  "appName": "Island Dock",
  "storageDirectoryName": "Island Dock",
  "configFileName": "config.json",
  "statusSymbol": "capsule",
  "chrome": {
    "hoverOpenDelay": 0.12,
    "cornerRadius": 16,
    "compactPadding": 4,
    "expandedPadding": 12,
    "expandedWidth": 440,
    "expandedHeight": 300,
    "fallbackCapsuleWidth": 220,
    "fallbackCapsuleHeight": 36
  },
  "modules": [
    { "id": "timer", "enabled": true, "symbol": "timer" },
    { "id": "snippets", "enabled": true, "symbol": "doc.on.clipboard" },
    { "id": "todo", "enabled": true, "symbol": "checklist" }
  ],
  "files": {
    "snippets": "snippets.json",
    "todos": "todos.json",
    "timer": "timer.json"
  },
  "timer": {
    "defaultSeconds": 1500,
    "presetSeconds": [900, 1500, 3000],
    "maxMinutes": 60,
    "tickSeconds": 1,
    "completionSound": "Glass"
  },
  "snippets": {
    "copiedHintSeconds": 1.2
  },
  "commands": {
    "pinSymbol": "pin",
    "unpinSymbol": "pin.fill"
  },
  "settings": {
    "shortcut": ",",
    "width": 360,
    "padding": 20
  },
  "language": {
    "selected": "en",
    "followsSystem": true,
    "options": [
      { "id": "en", "label": "English" },
      { "id": "de", "label": "Deutsch" },
      { "id": "fr", "label": "Français" },
      { "id": "es", "label": "Español" },
      { "id": "ru", "label": "Русский" }
    ]
  }
}
